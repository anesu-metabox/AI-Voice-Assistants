# AI Voice Bot Environment Configuration

# LiveKit Cloud (WebRTC Media Infrastructure)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# Core Voice Engine (Google Gemini Live - ADR-008 Active Baseline)
GOOGLE_API_KEY=AIzaSy...

# Optional Production Fallback Voice Engine (ADR-007 Modular Stack)
# DEEPGRAM_API_KEY=...
# CARTESIA_API_KEY=...

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:...@ep-....neon.tech/neondb?sslmode=require
# Apply migrations with the direct/unpooled endpoint; application traffic must
# use a dedicated NOSUPERUSER NOBYPASSRLS role in production.
DATABASE_URL_UNPOOLED=postgresql://migration_role:...@ep-....neon.tech/neondb?sslmode=require
APP_ENV=development
RUNTIME_DB_ROLE=voice_bot_runtime
RUNTIME_DB_PASSWORD=replace-with-a-long-random-password

# Signed service context shared only by the authenticated session broker,
# FastAPI, and the LiveKit worker. Never expose these to the browser.
LIVEKIT_SESSION_CONTEXT_SECRET=replace-with-a-long-random-secret
LIVEKIT_SESSION_CONTEXT_MAX_AGE_SECONDS=300
NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
# Canonical browser origin used by Next.js mutation proxies (Railway deployment URL in production).
APP_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-different-long-random-secret

# Private backend-to-credential-broker channel. scripts/dev.ps1 creates an
# ephemeral local secret if this is unset; production must inject a unique
# random secret into only the backend and credential-broker workloads.
CREDENTIAL_BROKER_URL=http://127.0.0.1:8001
CREDENTIAL_BROKER_SHARED_SECRET=

# Local development and Railway: the credential broker imports only its
# explicit secret allowlist; the API/frontend/worker must not receive these.
# For Railway, set this as a service secret on the private Credential Broker
# only. Generate 32 random bytes and encode them with URL-safe base64.
CREDENTIAL_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Set both previous-key variables only during a planned rotation. Keep the old
# key until all stored credentials have been re-encrypted under the new key.
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEY=
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEY_VERSION=

# External Tool APIs
# The OAuth client secret belongs only to the credential broker. In production
# configure it in the broker workload's secret manager, never in Next.js/agent.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
TRIGGER_API_KEY=...
