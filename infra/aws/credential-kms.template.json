{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Customer integration credential envelope-encryption key for the backend credential broker.",
  "Parameters": {
    "CredentialBrokerRoleArn": {
      "Type": "String",
      "Description": "ARN of the isolated integration-broker workload role that alone may encrypt/decrypt Google and 3CX credentials.",
      "AllowedPattern": "^arn:[^:]+:iam::[0-9]{12}:role/.+$"
    },
    "KeyAdminRoleArn": {
      "Type": "String",
      "Description": "ARN of the tightly controlled infrastructure role permitted to administer this key.",
      "AllowedPattern": "^arn:[^:]+:iam::[0-9]{12}:role/.+$"
    },
    "KeyAlias": {
      "Type": "String",
      "Default": "alias/voice-bot-credential-envelope",
      "AllowedPattern": "^alias/[A-Za-z0-9/_-]+$"
    }
  },
  "Resources": {
    "CredentialKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Envelope key for tenant-bound Google OAuth and 3CX credentials.",
        "Enabled": true,
        "EnableKeyRotation": true,
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "MultiRegion": false,
        "PendingWindowInDays": 30,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowAccountRootToDelegateKeyAdministration",
              "Effect": "Allow",
              "Principal": { "AWS": { "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root" } },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "AllowDedicatedCredentialBrokerCryptographicOperations",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "CredentialBrokerRoleArn" } },
              "Action": [ "kms:Decrypt", "kms:GenerateDataKey" ],
              "Resource": "*",
              "Condition": {
                "ForAllValues:StringEquals": {
                  "kms:EncryptionContextKeys": [ "company_id", "provider", "field", "version" ]
                },
                "Null": {
                  "kms:EncryptionContext:company_id": "false",
                  "kms:EncryptionContext:provider": "false",
                  "kms:EncryptionContext:field": "false",
                  "kms:EncryptionContext:version": "false"
                },
                "StringEquals": {
                  "kms:EncryptionContext:provider": [ "google", "threecx" ],
                  "kms:EncryptionContext:field": [ "access_token", "refresh_token", "api_key" ]
                }
              }
            },
            {
              "Sid": "AllowDedicatedRoleToAdministerKey",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "KeyAdminRoleArn" } },
              "Action": [
                "kms:CancelKeyDeletion",
                "kms:CreateAlias",
                "kms:DeleteAlias",
                "kms:DescribeKey",
                "kms:DisableKey",
                "kms:EnableKey",
                "kms:EnableKeyRotation",
                "kms:GetKeyPolicy",
                "kms:GetKeyRotationStatus",
                "kms:ListAliases",
                "kms:ListResourceTags",
                "kms:PutKeyPolicy",
                "kms:ScheduleKeyDeletion",
                "kms:TagResource",
                "kms:UntagResource",
                "kms:UpdateAlias"
              ],
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          { "Key": "Application", "Value": "voice-bot" },
          { "Key": "Purpose", "Value": "credential-envelope-encryption" },
          { "Key": "ManagedBy", "Value": "cloudformation" }
        ]
      }
    },
    "CredentialKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": { "Ref": "KeyAlias" },
        "TargetKeyId": { "Ref": "CredentialKey" }
      }
    }
  },
  "Outputs": {
    "CredentialKeyArn": {
      "Description": "Set as CREDENTIAL_KMS_KEY_ID in the backend credential broker environment.",
      "Value": { "Fn::GetAtt": [ "CredentialKey", "Arn" ] }
    },
    "CredentialKeyAlias": {
      "Value": { "Ref": "CredentialKeyAlias" }
    }
  }
}
