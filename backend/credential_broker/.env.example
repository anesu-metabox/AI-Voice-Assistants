# Local-development example only. Never put production secrets in this file;
# inject them into the broker workload from the deployment secret manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Optional only while rotating a Railway broker encryption key.
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEY=
# CREDENTIAL_ENCRYPTION_PREVIOUS_KEY_VERSION=

# Railway production: inject CREDENTIAL_ENCRYPTION_KEY as a Railway service
# secret on the private credential broker only. Do not configure AWS/KMS vars.
# APP_ENV=production
