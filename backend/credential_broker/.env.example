# Local-development example only. Never put production secrets in this file;
# inject them into the broker workload from the deployment secret manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREDENTIAL_KEY_PROVIDER=env
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Production-only broker workload configuration (do not use static AWS keys):
# APP_ENV=production
# CREDENTIAL_KEY_PROVIDER=aws-kms
# CREDENTIAL_KMS_KEY_ID=arn:aws:kms:region:account:key/key-id
# AWS_REGION=your-region
