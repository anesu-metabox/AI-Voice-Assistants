{
  "expo": {
    "name": "Vocalist Assistant Ai",
    "owner": "hackathon442",
    "slug": "vocalist-assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocalist.ai.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Voice Bot requires microphone access for real-time conversational voice interaction.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-foreground.png",
        "backgroundColor": "#5B6BF0"
      },
      "package": "com.vocalist.ai.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "scheme": "vocalist-mobile",
    "extra": {
      "eas": {
        "projectId": "0f9a7761-4848-49a3-baa2-28e135e9e5e6"
      }
    },
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
