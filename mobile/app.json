{
  "expo": {
    "name": "Vocalist Assistant Ai",
    "slug": "vocalist-assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/mascot-1.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/mascot-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1526"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocalist.ai.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Voice Bot requires microphone access for real-time conversational voice interaction.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/mascot-1.png",
        "backgroundColor": "#0D1526"
      },
      "package": "com.vocalist.ai.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "scheme": "vocalist-mobile",
    "plugins": [
      "expo-router",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
